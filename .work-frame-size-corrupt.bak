    //   `html,body{鈥?overflow:hidden!important}`锛堣 ST-IFRAME-SPEC.md 搂1锛夈€?    //   鎴戜滑姝ゅ墠鏄€屾í鍚?hidden銆佺旱鍚?auto銆嶇殑鍋忕锛岀悊鐢辨槸"璁╁崱鑷繁鑳芥粴"锛涗絾閭ｆ潯鍋忕
    //   姝ｆ槸鐢ㄦ埛鐪嬪埌鐨?妗嗛噷杩樻湁婊氬姩鏉?锛岃€屼笖鍜岄珮搴﹀彛寰勪簰涓哄洜鏋滐紙绾靛悜闈犳粴鍔ㄥ厹搴?鈬?    //   鍐呭鍐嶉珮涔熶笉鎶ラ珮搴︼級銆傜幇鍦ㄩ珮搴︽寜鍐呭閲忚蛋 鈬?蹇呴』璺?ST 涓€鏍?hidden銆?    //   鈿?鎯虫敼鍥?`overflow-y:auto` 涔嬪墠锛屽厛璇?muvCardResetCss 鐨勬敞閲婁笌 搂8 鍋忕琛ㄣ€?    ['html,body overflow:hidden!important锛圫T 鍙ｅ緞锛岀畝鍐欏睘鎬э級', /html\s*,\s*body\{[^}]*overflow:hidden!important/],
  ]
  for (const [label, re] of need) check('B: reset 鍚?' + label, re.test(resetProbe), resetProbe.slice(0, 260))
  // 鍙嶅悜鏂█锛氶攣姝绘棫鍋忕锛屽埆璁╁畠鎮勬倓鍥為€€锛堝洖閫€浜嗗崱閲屽氨浼氶噸鏂伴暱鍑哄唴閮ㄦ粴鍔ㄦ潯锛?  check('B: reset 涓嶅惈 overflow-y:auto锛堟棫鍋忕涓嶈鍥為€€锛?,
    !/overflow-y\s*:\s*auto/.test(resetProbe), resetProbe.slice(0, 260))
  check('B: reset 鍦?<body> 涔嬪墠锛堢涓€甯у氨鐢熸晥锛屼笉闂級', resetProbe.indexOf('<style') < resetProbe.indexOf('<body'), resetProbe.slice(0, 200))
  check('B: <script> 閲岀殑 <head> 涓嶅綋浣滄敞鍏ョ偣', (() => {
