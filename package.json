{
  "name": "dsh-muv-engine",
  "version": "0.4.0",
  "description": "DSH 原生 MUV 引擎 —— 正则脚本、状态栏级联（任意字段/行动选项）、变量追踪、LaTeX、宏展开、标签 CSS、visual 代码块渲染（信纸/终端/报纸/手机），内置 diag.mjs 诊断工具。需与伴生插件 dsh-muv-table 一起安装",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "diag.mjs",
    "tests/test-status-cascade.mjs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "muv",
    "magvarupdate",
    "tavern"
  ],
  "license": "PolyForm-Noncommercial-Copyleft-1.0.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chen731215-dev/dsh-muv-engine.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dsh-muv-table": "^0.2.2"
  },
  "peerDependencies": {
    "dsh-muv-table": "^0.2.2"
  },
  "peerDependenciesMeta": {
    "dsh-muv-table": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node tools/run-each-test.mjs",
    "test:all": "node tools/run-each-test.mjs --all",
    "check": "node --no-warnings --experimental-vm-modules tools/check-syntax.mjs",
    "check:hygiene": "node tools/check-repo-hygiene.mjs",
    "build:client": "node tools/build-client.mjs",
    "check:client-freshness": "node tools/build-client.mjs --check",
    "ci:local": "npm run check && npm test && npm run check:hygiene && npm run check:client-freshness"
  }
}
