      ' 鍑犱綍搴曡竟=' + m2.topBottom + ' / 鏂囨。=' + m2.docScroll)
    check('鈽呪槄 鍐荤煭甯ч珮鍚庛€屾粴鍔ㄦ孩鍑哄彛寰勩€嶅繀椤荤孩锛堝惁鍒欎笂闈㈤偅涓ゆ潯鏄亽鐪燂級', over2 > 2, '婊氬姩婧㈠嚭=' + over2 + 'px')
    check('鈽呪槄 鍐荤煭甯ч珮鍚庛€屽嚑浣曞簳杈广€嶄篃蹇呴』绾紙鐪熻鍒囦笅涓や釜鍙ｅ緞鏂瑰悜涓€鑷达級',
      m2.topBottom > m2.docScroll + 1, '搴曡竟=' + m2.topBottom + ' 鏂囨。=' + m2.docScroll)
  }
} finally {
  rt.close()
}

console.log(`\n=== 鏂█: ${pass} 閫氳繃, ${fail} 澶辫触 ===`)
console.log('浜х墿: ' + OUT)
process.exit(fail ? 1 : 0)

