// 鈹€鈹€ 鐖堕〉璁拌处锛氬悓涓€浠?raw 璋冧袱娆★紝浜х墿蹇呴』閫愬瓧鑺傜浉鍚岋紝涓旀敞鍏ョ紦瀛樺彧澧?1 椤?鈹€鈹€
// 杩欐潯鎸＄殑鏄?姣忔閲嶅缓閮藉線缂撳瓨閲屽涓€浠芥柊浜х墿"杩欑鐪嬩笉瑙佺殑娉勬紡锛氬崱涓€澶氾紙鎴栨秷鎭竴閲嶆覆鏌擄級
// 鍐呭瓨灏辫窡鐫€娑紝鑰?*澶栬涓婂畬鍏ㄦ甯?*銆傞€愬瓧鑺傜浉鍚屽悓鏃朵篃鏄箓绛夋€х殑鍓嶆彁鏉′欢銆?{
  const raw = '<!DOCTYPE html><html><head><title>t</title></head><body><p>hi</p></body></html>'
  // `muvInjectCache` 鏄埗椤电殑妯″潡绾?`var`锛坈lient.js:2264锛夈€傝繖閲屾妸瀹冨綋 **dep 浼犺繘鍘?*
  // 锛堜笉鏄瀹冭嚜鍔ㄦ敞鍏ワ級锛氳嚜鍔ㄦ敞鍏ヤ細鎶?`var muvInjectCache = {}` 涔熷杩涘嚱鏁板ご锛?  // 閭ｄ細**閲嶇疆**鎺夋垜浠兂瑙傛祴鐨勯偅涓璞★紙var 閲嶅澹版槑鎶婂弬鏁扮殑鍊煎啿鎺夛級銆?  const cache = {}
  const api2 = buildFrom(SRC, ['cardHtmlIframe'],
    { MUV_CARD_SANDBOX: SANDBOX, muvInjectCache: cache, window: { addEventListener() {} }, document: { querySelectorAll: () => [] } },
    '({html:cardHtmlIframe,gc:function(){var n=0;for(var k in muvInjectCache){if(Object.prototype.hasOwnProperty.call(muvInjectCache,k))n++}return n}})')
  const raw2 = '<!DOCTYPE html><html><head><title>t2</title></head><body><p>yo</p></body></html>'
  const n0 = api2.gc()
  const a1 = api2.html(raw)
  const a2 = api2.html(raw)
  check('鈽?鍚屼竴 raw 涓ゆ cardHtmlIframe 浜х墿閫愬瓧鑺傜浉鍚岋紙骞傜瓑锛屼笉鍚椂闂存埑/闅忔満鏁帮級', a1 === a2,
    '闀垮害 ' + a1.length + ' vs ' + a2.length + '锛岄澶勪笉鍚?@' +
    (() => { let i = 0; while (i < Math.min(a1.length, a2.length) && a1[i] === a2[i]) i++; return i })())
  const n1 = api2.gc()
  const a3 = api2.html(raw)
  const n2 = api2.gc()
  const b1 = api2.html(raw2)
  const n3 = api2.gc()
  // 杩欐潯鎸＄殑鏄?姣忔閲嶅缓閮藉線缂撳瓨閲屽涓€浠芥柊浜х墿"杩欑鐪嬩笉瑙佺殑娉勬紡锛氬崱涓€澶氥€佹秷鎭竴閲嶆覆鏌擄紝
  // 鍐呭瓨灏辫窡鐫€娑紝鑰?*澶栬涓婂畬鍏ㄦ甯?*銆傚垽鎹槸"鍚?raw N 娆?鈬?鎭板ソ 1 椤?锛屼笉鏄?N 娆?鈬?N 椤?銆?  check('鈽?鐖堕〉 muvInjectCache 鎸?raw 璁拌处锛氬悓 raw 璋?3 娆″彧鍏ヨ处 1 椤?, n1 === n0 + 1 && n2 === n0 + 1,
    '璧峰 ' + n0 + ' 鈫?绗?1 娆?' + n1 + ' 鈫?绗?3 娆?' + n2 + '锛堟瘡娆′骇鐗╅兘涓庨娆＄浉鍚岋紵' + (a3 === a1) + '锛?)
  check('鈽?鎹竴浠?raw 鎵?+1锛堜笉鏄?浠€涔堥兘娌¤"锛?, n3 === n0 + 2 && b1 !== a1,
    '鏂?raw 鍚?' + n3 + ' 椤癸紙鏈熸湜 ' + (n0 + 2) + '锛?)
}

