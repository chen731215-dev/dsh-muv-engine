{
  "name": "dsh-muv-engine",
  "version": "0.3.8",
  "description": "DSH 原生 MUV 引擎 —— 正则脚本、状态栏级联（任意字段/行动选项）、变量追踪、LaTeX、宏展开、标签 CSS、visual 代码块渲染（信纸/终端/报纸/手机），内置 diag.mjs 诊断工具。需与伴生插件 dsh-muv-table 一起安装",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "CHANGELOG.md", "README.md", "diag.mjs", "test-status-cascade.mjs"],
  "keywords": ["dsh", "dsh-plugin", "muv", "magvarupdate", "tavern"],
  "license": "PolyForm-Noncommercial-Copyleft-1.0.0",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "repository": {"type": "git", "url": "git+https://github.com/chen731215-dev/dsh-muv-engine.git"},
  "engines": { "node": ">=20" },
  "dependencies": {
    "dsh-muv-table": "^0.2.2"
  },
  "peerDependencies": {
    "dsh-muv-table": "^0.2.2"
  },
  "peerDependenciesMeta": {
    "dsh-muv-table": { "optional": true }
  }
}