{
  // 鎷夸笉鍒板彲淇¤鍙ｉ珮鏃跺繀椤?*涓嶉噸鍐?*锛堝啓涓敊鐨勫浐瀹氬€兼瘮涓嶆敼鏇寸碂锛?  const noVh = buildFrom(SRC, ['rewriteVhMinHeight'], { MUV_CARD_SANDBOX: SANDBOX, window: {}, document: { querySelectorAll: () => [] } }, 'rewriteVhMinHeight')
