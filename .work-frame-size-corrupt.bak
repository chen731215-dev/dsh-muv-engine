      return w(resetProbe) === resetProbe
    } catch (_) { return false }
  })())
}
const iframeTag = (/<iframe\b[^>]*>/.exec(api.cardHtmlIframe('<p>x</p>')) || [''])[0].replace(/srcdoc="[^"]*"/, 'srcdoc="鈥?')
check('C: iframe 鏍囩鍐呰仈浜?display:block', /display:block/.test(iframeTag), iframeTag)
