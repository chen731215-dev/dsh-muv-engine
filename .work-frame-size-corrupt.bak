  return m ? m[0] : ''
})()

// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?A1. 閲嶅啓鐨勫崟鍏冩柇瑷€ 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?console.log('=== A1. min-height:鈥h 閲嶅啓锛堝崟鍏冿紝娉ㄥ叆 window.innerHeight=1080锛?==')
const R = api.rewriteVhMinHeight
check('100vh 鈫?1080px', R('a{min-height:100vh}').includes('min-height:1080px'), R('a{min-height:100vh}'))
check('甯︾┖鏍?`min-height: 100vh` 涔熼噸鍐?, R('a{min-height: 100vh}').includes('min-height:1080px'), R('a{min-height: 100vh}'))
